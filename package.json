{
  "name": "master-space-master",
  "version": "1.5.1",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "referee:bundle": "node scripts/build-referee.mjs",
    "referee:check": "node scripts/build-referee.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "vitest run tests/",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "video:capture": "bash scripts/capture-action-videos.sh",
    "video:verify": "bash scripts/verify-action-videos.sh",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease",
    "version": "node scripts/sync-android-version.js && git add android/app/build.gradle",
    "postversion": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@mlc-ai/web-llm": "^0.2.81",
    "@supabase/supabase-js": "^2.98.0",
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@types/node": "^25.3.2",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
